# Canonical production origin. Used by metadata, sitemap, and robots.
SITE_URL=https://io.fitness

# Optional webmaster verification tokens (server metadata only).
# Paste the value from Search Console / Bing Webmaster Tools — do not invent tokens.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional. Overrides the IndexNow key derived from public/{key}.txt.
# INDEXNOW_KEY=
