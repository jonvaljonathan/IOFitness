# Canonical production origin. Used by metadata, sitemap, and robots.
SITE_URL=https://io.fitness

# Optional webmaster verification tokens (server metadata only).
# Paste the value from Search Console / Bing Webmaster Tools — do not invent tokens.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional. Overrides the IndexNow key derived from public/{key}.txt.
# INDEXNOW_KEY=

# Required for early-access form persistence (server-side only).
# Use the same Supabase project as the iofit training app (jonvaljonathan/iofit).
# Never expose these to the browser / NEXT_PUBLIC_*.
#
# Names match iofit `.env.example`:
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional alias accepted by the server action (Supabase edge-function name):
# SUPABASE_SERVICE_ROLE_KEY=
